cache/

# --- Project data & results ----------------------------------------------
# Road-network downloads and experiment outputs are reproducible artefacts:
# regenerate them with the pipeline instead of committing them.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

results/*
!results/.gitkeep

# --- OS noise -------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
